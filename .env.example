# Copy this file to .env and fill in real values. Never commit .env.

# SQLite for local work, Postgres on Render
DATABASE_URL=sqlite:///./trailmark.db

# Long random string, used to sign login tokens
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none when frontend and backend
# are on different domains (Vercel and Render)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Address the frontend runs on, allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# AI service key. Without it the analysis uses saved results or a basic listing.
# LLM_PROVIDER is "anthropic", "groq" or "gemini" (Groq and Gemini have free tiers).
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Gemini free tier, for example: LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.1-flash-lite
# Optional second model, tried if the main one keeps failing
LLM_FALLBACK_MODEL=
